# Telegram bot tokeni
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"

# Ma'lumotlar bazasi (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kairyx_db

# Redis (FSM holatlari va kesh uchun)
REDIS_HOST=localhost
REDIS_PORT=6379

# Adminlar (Telegram ID raqamlari vergul bilan ajratiladi)
# Bu yerga kiritilgan adminlar "super admin" hisoblanadi va botdagi boshqa adminlarni boshqara oladi.
ADMIN_IDS="7992878834,12345678"

# AI uchun API kaliti (Anthropic yoki OpenAI)
AI_API_KEY="YOUR_AI_API_KEY_HERE"
# Telegram Mini App (WebApp) URL - HTTPS kerak
# GitHub Pages yoki boshqa hosting orqali deploy qilinadi
WEBAPP_URL="https://your-username.github.io/amorix-bot/webapp/"
